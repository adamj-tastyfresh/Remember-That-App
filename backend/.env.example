# Copy this file to .env and fill in real values. Never commit the .env file.

PORT=4000
APP_ORIGIN=http://localhost:5173

# Microsoft SQL Server connection (internal network only)
DB_SERVER=localhost
DB_NAME=CHANGE_ME_SHARED_DATABASE
DB_USER=remme_app
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Internal SeaweedFS S3-compatible attachment storage. Credentials are
# server-side secrets and must never be exposed through VITE_* variables.
S3_ENDPOINT=https://seaweedfs.tastytrucks.com.au
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=remember-that
S3_REGION=us-east-1
